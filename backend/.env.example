# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB=adaptivelearnse_dev
C1_AI_URL=http://127.0.0.1:8001
C3_AI_URL=http://127.0.0.1:8003
# Long random text used to sign login tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The administrator account. Only the person who runs the seed script needs these.
# After filling them in, run once from the backend folder:  node scripts/seedAdmin.js
# ADMIN_ID must be SLIITADMIN followed by 0 to 9 digits. ADMIN_PASSWORD needs 10+ characters.
ADMIN_ID=SLIITADMIN1
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
