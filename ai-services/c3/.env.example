# ==============================================================================
# AdaptiveLearnSE Component 3 — AI Microservice Environment Configuration
# ==============================================================================
# Port for the FastAPI AI microservice (Default: 8003)
C3_PORT=8003

# LLM Provider: 'mock' (Default, zero cost, fully offline), 'openai', or 'local'
C3_LLM_PROVIDER=mock
C3_DEFAULT_MODEL=mock-gpt4o

# Optional: Live Cloud Execution (Requires Paid Account — NOT REQUIRED FOR PP1)
# Leave blank to run 100% offline at $0.00 cost using calibrated mock simulation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Local Ollama Daemon (Defaults to http://localhost:11434 if used)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: Vector Store Backend ('auto', 'sentence-transformers', or 'tfidf')
C3_VECTOR_BACKEND=auto

# Optional: Live Neo4j Instance (Defaults to in-memory graph fallback if offline)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
