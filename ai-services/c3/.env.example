# ==============================================================================
# AdaptiveLearnSE Component 3 — AI Microservice Environment Configuration
# Copy to .env (never commit .env). All LLM/embedding calls are REAL; there is no mock provider.
# ==============================================================================
C3_PORT=8003

# --- LLM provider: gemini (default) | openai | local (Ollama) -----------------
C3_LLM_PROVIDER=gemini

# Gemini (default provider). The model name is verified against ListModels before experiment runs.
GEMINI_API_KEY=
C3_GEMINI_MODEL=gemini-3.6-flash
# Model that writes the synthetic dataset (must differ from the verifier and from C3_GEMINI_MODEL; verified callable)
C3_GENERATOR_MODEL=gemini-3-flash-preview
# Independent blind re-grader (verifier) used by the dataset generator: openai (default) | gemini.
# It must NOT be the generator itself; the manifest records whether both share a model family.
# Needs OPENAI_API_KEY (openai) or GEMINI_API_KEY (gemini). Verify the models first with:
#   python datasets/generate_c3_dataset.py --preflight
C3_VERIFIER_PROVIDER=gemini
C3_VERIFIER_MODEL=gemini-3.5-flash-lite
# Optional: 0 disables "thinking" tokens on models that allow it
# C3_GEMINI_THINKING_LEVEL=low   (gemini-3 models; default low - higher levels exhaust the output budget)
# C3_GEMINI_THINKING_BUDGET=0

# OpenAI (second provider for the multi-LLM comparison)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
C3_OPENAI_MODEL=gpt-4o-mini

# Optional local Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Rate limiting / retries (apply to all remote providers) ------------------
# Requests STARTED per minute, per provider key, shared by all threads (not a concurrency limit; every retry
# attempt counts). 0 = unlimited.
C3_LLM_RPM=0
# Optional per-provider overrides (so one provider's quota does not throttle the other); unset = use C3_LLM_RPM
# Free-tier Gemini measured at 5 requests/min per model; limiter is per model. Use 4 to stay below it.
C3_LLM_RPM_GEMINI=4
C3_LLM_RPM_OPENAI=
C3_LLM_MAX_RETRIES=5

# --- Retrieval ----------------------------------------------------------------
# dense = real embeddings from C3_EMBEDDING_PROVIDER; tfidf = explicit lexical baseline
C3_VECTOR_BACKEND=dense
C3_EMBEDDING_PROVIDER=gemini
C3_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
C3_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Neo4j CCKG (matches docker-compose.yml) -----------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-development
# 1 = fail instead of using the in-memory ontology when Neo4j is unreachable (set for experiments)
C3_CCKG_STRICT=0
