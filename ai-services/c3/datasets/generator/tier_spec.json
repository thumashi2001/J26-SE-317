{
  "spec_version": "1.0.0",
  "dataset_version": "C3-v6.0.0",
  "core_tiers": ["FULL", "MOSTLY_CORRECT", "PARTIAL", "MISSING_CONCEPT", "MISCONCEPTION", "IRRELEVANT"],
  "edge_tiers": ["EMPTY", "TOO_SHORT", "CONTRADICTORY", "PARAPHRASE_FULL", "TYPO_FULL"],
  "deterministic_tiers": ["EMPTY", "TOO_SHORT"],
  "order_chain": [
    {"higher": "FULL", "lower": "MOSTLY_CORRECT", "strict": false},
    {"higher": "MOSTLY_CORRECT", "lower": "PARTIAL", "strict": true},
    {"higher": "PARTIAL", "lower": "MISSING_CONCEPT", "strict": false},
    {"higher": "MISSING_CONCEPT", "lower": "MISCONCEPTION", "strict": false},
    {"higher": "MISCONCEPTION", "lower": "IRRELEVANT", "strict": false}
  ],
  "plan_rules": {
    "FULL": {"kind": "all_top", "description": "top level on every criterion"},
    "MOSTLY_CORRECT": {"kind": "all_top_except_one_lower", "description": "top everywhere except one criterion one level lower"},
    "PARTIAL": {"kind": "middle", "description": "a middle (non-zero, non-top) level on every criterion"},
    "MISSING_CONCEPT": {"kind": "half_top_half_zero", "top_fraction": 0.5, "description": "top level on about half of the criteria, mark-0 level on the rest; omitted concepts never mentioned"},
    "MISCONCEPTION": {"kind": "misconception", "related_fraction": 0.6, "max_lowest_nonzero_criteria": 1, "description": "mark-0 on misconception-related criteria; at most one other criterion at the lowest non-zero level"},
    "IRRELEVANT": {"kind": "all_zero", "sub_kinds": ["same_domain_wrong_topic", "generic_padding", "unrelated_essay", "keyword_stuffed"]},
    "EMPTY": {"kind": "all_zero", "sub_kinds": ["empty", "whitespace"]},
    "TOO_SHORT": {"kind": "all_zero", "max_words": 7},
    "CONTRADICTORY": {"kind": "lowest_nonzero_on_half", "description": "states a correct claim then negates it; lowest non-zero level on about half of the criteria"},
    "PARAPHRASE_FULL": {"kind": "all_top", "description": "FULL content, different wording"},
    "TYPO_FULL": {"kind": "all_top", "description": "FULL content with spelling errors"}
  },
  "normalized_mark_ranges": {
    "FULL": {"min": 1.0, "max": 1.0},
    "PARAPHRASE_FULL": {"min": 1.0, "max": 1.0},
    "TYPO_FULL": {"min": 1.0, "max": 1.0},
    "MOSTLY_CORRECT": {"min": 0.3, "max": 1.0, "max_exclusive": true},
    "PARTIAL": {"min": 0.0, "max": 1.0, "min_exclusive": true, "max_exclusive": true},
    "MISSING_CONCEPT": {"min": 0.0, "max": 0.85},
    "MISCONCEPTION": {"min": 0.0, "max": 0.5},
    "IRRELEVANT": {"min": 0.0, "max": 0.0},
    "EMPTY": {"min": 0.0, "max": 0.0},
    "TOO_SHORT": {"min": 0.0, "max": 0.3},
    "CONTRADICTORY": {"min": 0.0, "max": 0.7}
  },
  "styles": ["concise", "standard", "verbose"],
  "registers": ["formal", "informal", "minor_typos"],
  "style_word_ranges": {
    "concise": {"min": 12, "max": 70},
    "standard": {"min": 45, "max": 150},
    "verbose": {"min": 100, "max": 320}
  },
  "thresholds": {
    "max_length_mark_pearson": 0.4,
    "length_corr_exclude_tiers": ["EMPTY", "TOO_SHORT"],
    "max_share_on_top7_ratios": 0.45,
    "ratio_metric": "share of answers on the 7 most frequent normalized-mark ratios (3 d.p.), excluding the structural anchors 0 and 1",
    "ratio_metric_scope": "dataset-wide, hard check, labels strictly between 0 and 1, top-7 most frequent ratios rounded to 3 d.p., denominator = number of such labels",
    "min_distinct_sentence_ratio": 0.7,
    "max_cross_split_cosine": 0.8,
    "max_answer_near_duplicate_cosine": 0.9,
    "max_reference_cosine_non_full": 0.8,
    "max_reference_cosine_full": 0.92,
    "max_ocr_noise_ratio": 0.03,
    "max_cue_classifier_accuracy": 0.5,
    "cue_min_test_samples": 60,
    "min_questions_for_module_in_every_split": 3,
    "split_ratios": {"train": 0.70, "validation": 0.15, "test": 0.15},
    "min_expected_concepts": 3,
    "max_expected_concepts": 8,
    "min_criteria": 2,
    "max_criteria": 6,
    "min_levels": 3,
    "max_levels": 5,
    "reference_words_min": 80,
    "reference_words_max": 250,
    "needs_review_level_gap": 2,
    "needs_review_total_deviation": 0.25,
    "expert_review_fraction": 0.10,
    "max_regeneration_tries": 3,
    "max_llm_retries": 3
  },
  "banned_cue_phrases": [
    "does not cover", "doesn't cover", "did not cover", "fails to mention", "failed to mention",
    "does not mention", "missing concept", "partially correct", "mostly correct",
    "fully correct", "full marks", "no marks", "as an ai", "this answer", "the answer does not",
    "rubric", "marking scheme", "reference answer", "i was asked to", "irrelevant answer"
  ],
  "placeholder_concepts": [
    "conceptual understanding", "supporting evidence", "key concept", "key concepts", "relevant concept",
    "relevant concepts", "main idea", "main ideas", "core idea", "general knowledge", "technical detail",
    "technical details", "important point", "important points", "concept 1", "concept 2", "concept 3",
    "concept a", "concept b", "placeholder", "tbd", "n/a", "other"
  ],
  "concept_status_values": ["demonstrated", "partial", "missing", "incorrect"],
  "graph_edge_types": ["prerequisite_of", "part_of", "depends_on", "contrasts_with", "causes", "example_of"],
  "forbidden_text_values": ["nan", "none", "null"],
  "rubric_status_values": ["llm_drafted_unverified"],
  "scope_status_values": ["in_scope_text_answerable"]
}
