
{
  "schema_version": "1.0",
  "schema_name": "syllabus_topic_review",
  "description": "Schema for human verification decisions on extracted syllabus topic candidates.",
  "required_fields": [
    "candidate_id",
    "module_key",
    "candidate_name",
    "review_decision",
    "verification_status",
    "reviewer_id",
    "reviewed_at",
    "review_notes",
    "sources"
  ],
  "fields": {
    "candidate_id": {
      "type": "string",
      "min_length": 1
    },
    "module_key": {
      "type": "string",
      "min_length": 1
    },
    "candidate_name": {
      "type": "string",
      "min_length": 1
    },
    "review_decision": {
      "type": "string",
      "allowed_values": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "verification_status": {
      "type": "string",
      "allowed_values": [
        "unverified",
        "verified",
        "rejected"
      ]
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "iso8601"
    },
    "review_notes": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "min_items": 1
    }
  },
  "decision_rules": {
    "pending": {
      "verification_status": "unverified",
      "reviewer_required": false,
      "reviewed_at_required": false
    },
    "approved": {
      "verification_status": "verified",
      "reviewer_required": true,
      "reviewed_at_required": true
    },
    "rejected": {
      "verification_status": "rejected",
      "reviewer_required": true,
      "reviewed_at_required": true
    }
  },
  "safeguards": {
    "automatic_verification_allowed": false,
    "manual_review_required": true,
    "preserve_source_evidence": true,
    "preserve_review_history": true
  }
}
