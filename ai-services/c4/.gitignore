# Local / Colab outputs (C4-specific; repo root may add broader rules)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep

# Presentation results: track small evidence JSON/CSV/MD only
experiments/results/**
!experiments/results/.gitkeep
!experiments/results/README.md
!experiments/results/**/
!experiments/results/**/*.json
!experiments/results/**/*.csv
!experiments/results/**/*.md

# Local toy SE smoke run (keep on disk; not presentation evidence).
# Must follow result allowlist so those negations do not re-include it.
experiments/results/local_se_smoke_ONLY/
experiments/results/local_se_smoke_ONLY/**

**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/

# Colab source ZIPs (not SB3 checkpoint zips under services/models/)
c4-source-colab.zip
c4-se-source-colab.zip
c4-se-supervised-source-colab.zip
c4-se-v1-source-colab.zip
c4-se-supervised-v1-source-colab.zip
C4_complete_backup_*.zip
C4_v1_07_08_complete_*.zip
C4_multi_v2_coverage_r2_complete_*.zip

# Active inference bundles (binaries + large exports)
runtime-artifacts/**
!runtime-artifacts/.gitkeep
!runtime-artifacts/README.md

# Colab Drive archive bulk (README + .gitkeep may be tracked)
local-colab-archive/*
!local-colab-archive/.gitkeep
!local-colab-archive/README.md

# Presentation model copies: metadata only on Git; weights stay local
services/models/**
!services/models/README.md
!services/models/**/
!services/models/**/*.json
!services/models/**/*.md
!services/models/**/*.csv
services/models/**/*.joblib
services/models/**/**/*.zip

# Disposable local-only helper output (optional scripts)
experiments/ORGANIZE_C4_STRUCTURE_REPORT.json
local-colab-archive/COPY_REPORT.json

# Legacy duplicate notebooks + one-off organization scripts (local only)
/experiments/executed/
/scripts/organize_colab_backup.py
/scripts/organize_c4_structure.py

# Optional local guides/templates (not required by packaging/runtime/tests).
# Keep README_SE_COLAB.md and README_SE_SUPERVISED_COLAB.md — package_* scripts include them.
# Keep MODEL_CARD.md and MODEL_CARD_SE_SIMULATION.md — filled result cards.
/MODEL_CARD_TEMPLATE.md
/README_COLAB.md
/experiments/notebooks/README.md.conflict_preserve_existing
